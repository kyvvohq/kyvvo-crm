PORT=3005
PUBLIC_URL=https://crm.kyvvo.com.br

# Postgres isolado deste serviço (nunca o mesmo banco do Kyvvo principal)
DATABASE_URL=postgres://user:password@localhost:5432/kyvvo_crm
PGSSL=false

CRM_JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Identidade/sessão: kyvvo-platform (mesmo serviço que Studio e People usam).
# Endereço interno na rede do compose (sem hairpin pela internet).
PLATFORM_URL=http://platform:3003

# Segredo compartilhado com kyvvo-admin pras rotas /crm/admin-interno/* (admin
# chamando pra dentro) e pra ADMIN_INTERNAL_URL abaixo (CRM chamando pra fora,
# catálogo de disparos do onboarding — ver lib/provisionamento-whatsapp.js).
ADMIN_INTERNAL_TOKEN=troque-por-um-segredo-compartilhado-com-o-admin
ADMIN_INTERNAL_URL=http://admin:3004

# Agente de IA (Fase 2): chave da API da Anthropic e limite de mídia recebida
ANTHROPIC_API_KEY=
AGENTE_MIDIA_MAX_BYTES=20971520
